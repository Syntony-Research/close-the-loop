# Example only. Install keys and client secrets in your host's secret store.
# Never commit a populated copy. Every provider is optional and opt-in.
ARENA_LIVE_ENABLED=false
ARENA_ALLOWED_ORIGINS=https://your-org.github.io
AUTH_BASE_URL=https://your-arena.your-account.workers.dev
AUTH_FRONTEND_URL=https://your-org.github.io/close-the-loop/
AUTH_SESSION_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VERIFIED=false

# Full approved Azure HTTPS endpoints, fixed by the operator.
# Phi/Llama/Mistral/Qwen use /openai/v1/chat/completions.
# Claude uses /anthropic/v1/messages on services.ai.azure.com.
PHI_ENDPOINT=
PHI_MODEL=
PHI_API_KEY=
PHI_VERIFIED=false
LLAMA_ENDPOINT=
LLAMA_MODEL=
LLAMA_API_KEY=
LLAMA_VERIFIED=false
MISTRAL_ENDPOINT=
MISTRAL_MODEL=
MISTRAL_API_KEY=
MISTRAL_VERIFIED=false
CLAUDE_ENDPOINT=
CLAUDE_MODEL=
CLAUDE_API_KEY=
CLAUDE_VERIFIED=false
QWEN_ENDPOINT=
QWEN_MODEL=
QWEN_API_KEY=
QWEN_VERIFIED=false
# Gemini uses Google's fixed generateContent endpoint, with a server-held key.
GEMINI_ENDPOINT=
GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_VERIFIED=false
